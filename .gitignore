# For PCBs designed using KiCad: http://www.kicad-pcb.org/
# Format documentation: http://kicad-pcb.org/help/file-formats/

# Temporary files
*.000
*.bak
*.bck
*.kicad_pcb-bak
*.sch-bak
*~
_autosave-*
*.tmp
*-save.pro
*-save.kicad_pcb
fp-info-cache

# Netlist files (exported from Eeschema)
*.net

# Autorouter files (exported from Pcbnew)
*.dsn
*.ses

# Exported BOM files
*.xml
# I'll remove the BOM CSV after I have a wiki / build guide that includes the BOM
#*.csv


# Project specific

# Rendered Gerber files (exported from Pcbnew)
gerbers/

# Intermediate files like 3d models
pcb/intermediates/

# IDE files
.idea/
.cursor/

# local secrets, see docs/.env.example
.env

# local file server for Jekyll pages
#Gemfile
Gemfile.lock
docs/_site/
docs/.jekyll-cache
docs/.sass-cache/
docs/.jekyll-metadata
docs/vendor

# old release path. We use GitHub Releases now
docs/premade-models/

# 3MF assets are pulled from GitHub Release during pages deploy
docs/assets/3mf/*.3mf
# OpenSCAD presets. Should be copied by build/run script
docs/_data/phone_case.json
# 3d model build dir
build/
